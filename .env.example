# ===== Modo =====
# true (padrão): gera e registra relatórios/avisos sem enviar nada. Só mude para false quando quiser enviar de verdade.
DRY_RUN=true
LOG_LEVEL=info
TZ_DISPLAY=America/Sao_Paulo

# ===== Banco e arquivos (volumes no Docker) =====
DB_PATH=./data/bot.sqlite
PREVIEW_DIR=./data/previews

# ===== API oficial do Clash of Clans (https://developer.clashofclans.com) =====
# Chave JWT criada no portal, vinculada ao IP público do host que fará as consultas. Nunca commite este valor.
COC_API_TOKEN=
COC_API_BASE=https://api.clashofclans.com/v1
# Tag do clã, com ou sem #. Ex.: #2PP0YQ9L
CLAN_TAG=

# ===== WhatsApp (whatsapp-web.js, cliente não oficial) =====
# ID do grupo de destino (termina com @g.us). Descubra com: npm run wa:chats
WHATSAPP_GROUP_ID=
# Nome EXATO do grupo de destino. Se não bater com o grupo do ID acima, o envio é recusado.
# Use um grupo exclusivo de testes até autorizar o grupo real.
WHATSAPP_EXPECTED_GROUP_NAME=
WA_SESSION_PATH=./wa-session
WA_CLIENT_ID=clash-report-bot
# No Docker é definido pela imagem (/usr/bin/chromium). Localmente, aponte para um Chrome/Chromium instalado
# (ex.: /usr/bin/google-chrome-stable) se o Chromium do Puppeteer não foi baixado no npm install.
PUPPETEER_EXECUTABLE_PATH=
# Segundos para o WhatsApp confirmar cada mensagem (ACK do servidor). Sem confirmação no prazo, o item
# fica "uncertain" e NÃO é reenviado automaticamente. SEND_LEASE_SECONDS deve ser >= este valor + 30.
WA_ACK_TIMEOUT_SECONDS=30

# ===== Fontes de anúncios =====
SOURCE_BLOG_ENABLED=true
# Inbox do jogo: infraestrutura da Supercell, mas NÃO documentada/aberta. Opcional.
SOURCE_INBOX_ENABLED=false
SOURCE_LOCALE=pt

# ===== Agendamentos (cron no fuso TZ_DISPLAY) =====
REPORT_MONTHLY_CRON=0 9 1 * *
REPORT_WEEKLY_CRON=0 9 * * 1
# Relatório perdido (bot fora do ar) só é gerado se o horário previsto foi há menos de N horas
REPORT_CATCHUP_HOURS=6
POLL_CLAN_MINUTES=5
POLL_ANNOUNCEMENTS_MINUTES=60

# ===== Lembretes =====
REMINDER_LEAD_GLOBAL_HOURS=24
REMINDER_LEAD_CLAN_HOURS=2
# Âncora dos lembretes de eventos globais: end (padrão), start ou start,end
REMINDER_ANCHORS=end

# ===== Entrega =====
NOTICE_TTL_HOURS=6
REPORT_TTL_HOURS=12
SEND_MAX_ATTEMPTS=5
SEND_MIN_GAP_SECONDS=5
SEND_LEASE_SECONDS=120
MESSAGE_MAX_CHARS=3000

# ===== HTTP (só GET /health; 0 desativa) =====
HTTP_PORT=8080
