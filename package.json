{
  "name": "api-report-clash",
  "version": "0.1.0",
  "description": "Bot de relatórios de Clash of Clans para um grupo de WhatsApp (eventos globais + estado do clã)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "cli": "tsx src/cli/index.ts",
    "migrate": "tsx src/cli/index.ts migrate",
    "preview": "tsx src/cli/index.ts preview",
    "import": "tsx src/cli/index.ts import",
    "poll:once": "tsx src/cli/index.ts poll:once",
    "wa:auth": "tsx src/cli/index.ts wa:auth",
    "wa:chats": "tsx src/cli/index.ts wa:chats",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "patch-package --error-on-fail --error-on-warn"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "dotenv": "^17.2.1",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.39.5",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.0"
  }
}
